{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "venue": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "year": {
            "type": "integer",
            "minimum": 1
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "arxiv": {
            "type": [
              "object",
              "null"
            ]
          },
          "public_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "publication_status": {
            "enum": [
              "peer-reviewed journal",
              "scholarly book/monograph",
              "conference proceedings",
              "public preprint",
              "thesis/dissertation",
              "other public scholarly source"
            ]
          },
          "locators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "access_date": {
            "type": "string",
            "format": "date"
          },
          "audit_date": {
            "type": "string",
            "format": "date"
          },
          "interpretation_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "citation",
          "title",
          "venue",
          "role",
          "authors",
          "year",
          "doi",
          "arxiv",
          "public_urls",
          "publication_status",
          "locators",
          "access_date",
          "audit_date",
          "interpretation_notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "sources"
  ],
  "additionalProperties": false
}
